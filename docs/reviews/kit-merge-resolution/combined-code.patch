+      return {
+        x: rect.x - panel.x,
+        y: rect.y - panel.y,
+        width: rect.width,
+        height: rect.height,
+        font: css.font,
+        padding: css.padding,
+        background: css.backgroundColor,
+        radius: css.borderRadius,
