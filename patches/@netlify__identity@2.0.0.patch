diff --git a/dist/main.js b/dist/main.js
--- a/dist/main.js
+++ b/dist/main.js
@@ -605,6 +605,22 @@
   const client = getClient();
   const currentUser = client.currentUser();
   if (currentUser) {
+    // Restore provider-persisted sessions after session cookies disappear.
+    // A forced provider refresh validates revocation before recreating cookies.
+    if (!getCookie(NF_JWT_COOKIE)) {
+      try {
+        const jwt = await currentUser.jwt(true);
+        setBrowserAuthCookies(jwt, currentUser.tokenDetails()?.refresh_token);
+      } catch (error) {
+        if ([400, 401, 403].includes(error?.status)) {
+          currentUser.clearSession();
+          deleteBrowserAuthCookies();
+          return null;
+        }
+        // Offline is not logout. Preserve the SDK's existing storage.
+        throw AuthError.from(error);
+      }
+    }
     startTokenRefresh();
     return toUser(currentUser);
   }
